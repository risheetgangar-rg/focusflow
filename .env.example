# Supabase project settings — get these from your Supabase project's API settings page.
# Safe to expose to the browser (public anon key, RLS-protected).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL used to build auth email redirect links (magic link, signup confirm, password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Bypasses Row Level Security — never expose to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID) keys for browser push notifications (Phase 8).
# Generate your own: `node -e "console.log(require('web-push').generateVAPIDKeys())"`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the Vercel Cron job sends to authorize /api/notifications/send.
CRON_SECRET=

# Dev-only: used by scripts/create-test-users.ts and the RLS isolation test
# (src/repositories/profile-repository.rls.test.ts) to set up two throwaway
# accounts. Never used outside local/dev tooling.
TEST_USER_A_EMAIL=test-a@example.com
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=test-b@example.com
TEST_USER_B_PASSWORD=
