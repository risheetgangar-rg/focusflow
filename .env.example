# Supabase project settings: Project Settings -> API.
# Both are safe to expose to the browser (the anon/publishable key is protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where auth emails link back to (magic link, signup confirm, password reset).
# Locally: http://localhost:3000. In production: your deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Bypasses Row Level Security: never expose it to the client or commit a real value.
# Used by the reminder cron and the test-account seeding script.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID) keys for reminders.
# Generate your own: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Your site URL or a mailto: address; push services use it to contact you if something is wrong.
VAPID_SUBJECT=https://your-app.vercel.app

# Shared secret the Vercel Cron job sends to authorize /api/notifications/send.
CRON_SECRET=

# Dev-only: throwaway accounts for scripts/create-test-users.ts, the RLS isolation test
# (src/repositories/profile-repository.rls.test.ts) and the Playwright end-to-end tests.
# Never used outside local/dev tooling.
TEST_USER_A_EMAIL=test-a@example.com
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=test-b@example.com
TEST_USER_B_PASSWORD=

# Optional: let Playwright use a browser you already have ("msedge" or "chrome") instead of its own download.
# E2E_CHANNEL=msedge

# Voice add on Tasks (speech to text). Free key: https://console.deepgram.com
DEEPGRAM_API_KEY=
